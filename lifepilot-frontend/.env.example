# URL of your n8n chat webhook.
# Local dev (n8n running on your machine):
#   NEXT_PUBLIC_N8N_WEBHOOK_URL=http://localhost:5678/webhook/chat
# Production (n8n hosted somewhere reachable over HTTPS):
#   NEXT_PUBLIC_N8N_WEBHOOK_URL=https://your-n8n-host.example.com/webhook/chat
NEXT_PUBLIC_N8N_WEBHOOK_URL=http://localhost:5678/webhook/chat
